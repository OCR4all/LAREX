{
  "realm": "larex-dev",
  "enabled": true,
  "loginTheme": "keycloakify-larex",
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "clients": [
    {
      "clientId": "larex-backend-service",
      "enabled": true,
      "secret": "PLEASE_CHANGE_IN_PRODUCTION",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": false
    },
    {
      "clientId": "larex-frontend",
      "enabled": true,
      "publicClient": false,
      "secret": "PLEASE_CHANGE_IN_PRODUCTION",
      "name": "Larex Frontend",
      "description": "Client for the Larex Development Frontend",
      "redirectUris": [
        "http://larex.localhost/auth/keycloak",
        "http://larex.localhost/auth/keycloak/password-change",
        "http://larex.localhost/auth/keycloak/delete-account"
      ],
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "User ID Mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "sub",
            "jsonType.label": "String"
          }
        },
        {
          "name": "User ID in custom claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "user_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "realm roles for userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "false",
            "claim.name": "roles",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
