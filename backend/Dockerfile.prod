FROM gradle:9.1.0-jdk25-corretto@sha256:40d479e02db08b4a53542b3da8d3cf95464c834058899d3863db2ecae4a86cfa AS builder
LABEL maintainer="maximilian.noeth@uni-wuerzburg.de"
LABEL description="Build stage for the LAREX backend"

WORKDIR /app

COPY --chown=gradle:gradle build.gradle.kts settings.gradle.kts ./
COPY --chown=gradle:gradle src ./src

RUN gradle build --no-daemon -x test


FROM eclipse-temurin:25-jre-noble@sha256:e3b6f7887a50f20d8f07abf279d8a81a5953fb398a9555bd9edd56b9bd15968c
LABEL description="Production image for the LAREX backend"

WORKDIR /app

RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/80-retries \
    && apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends curl libvips42t64 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appgroup && useradd --no-log-init -r -g appgroup appuser

COPY --from=builder /app/build/libs/*.jar app.jar
COPY docker/entrypoint.sh /app/entrypoint.sh

RUN chown appuser:appgroup app.jar && chmod 755 /app/entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["/app/entrypoint.sh"]
