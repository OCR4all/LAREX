{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "larex-docs",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "./.output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "docs.larex.maxnth.com",
      "custom_domain": true
    }
  ]
}
