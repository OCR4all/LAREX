# Docs Production Dockerfile
FROM node:22-alpine AS builder

WORKDIR /workspace/docs

RUN corepack enable && corepack prepare pnpm@11.6.0 --activate

COPY docs/package.json docs/pnpm-lock.yaml docs/pnpm-workspace.yaml docs/.npmrc ./

RUN pnpm install --frozen-lockfile

COPY docs/ ./
COPY VERSION LICENSE /workspace/
COPY compose.prod*.yaml compose.actions.yaml /workspace/
COPY config/keycloak/ /workspace/config/keycloak/
COPY deployment/ /workspace/deployment/
COPY scripts/ /workspace/scripts/

RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm build

FROM node:22-alpine AS runner

WORKDIR /app

COPY --from=builder /workspace/docs/.output ./.output

RUN addgroup -g 1001 -S nodejs
RUN adduser -S nuxt -u 1001

RUN chown -R nuxt:nodejs /app
USER nuxt

EXPOSE 3000

ENV NODE_ENV=production
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

CMD ["node", ".output/server/index.mjs"]
