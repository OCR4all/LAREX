# Docs Production Dockerfile
FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS builder

WORKDIR /workspace/docs

RUN corepack enable && corepack prepare pnpm@11.6.0 --activate

COPY docs/package.json docs/pnpm-lock.yaml docs/pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile

# Content validation follows README and audit links into the repository sources.
COPY . /workspace/

RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm build

FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS runner

RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules /opt/yarn-* \
        /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
        /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -g 1001 -S nodejs \
    && adduser -S -u 1001 -G nodejs -h /app nuxt

WORKDIR /app

COPY --from=builder --chown=nuxt:nodejs /workspace/docs/.output ./.output

USER nuxt

EXPOSE 3000

ENV NODE_ENV=production
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

CMD ["node", ".output/server/index.mjs"]
