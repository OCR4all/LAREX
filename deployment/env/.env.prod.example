# LAREX default production preset (compose.prod.yaml)
# No Traefik, bundled Keycloak, direct host ports: frontend=3000, app=8080, keycloak=8090
# Usage:
#   cp deployment/env/.env.prod.example .env.prod
#   docker compose --env-file .env.prod -f compose.prod.yaml up -d

# Host interface for published ports (frontend/app/keycloak)
# Set to 0.0.0.0 only behind a trusted reverse proxy/firewall.
LAREX_PUBLISH_IP=127.0.0.1
LAREX_FRONTEND_PUBLISHED_PORT=3000
LAREX_KEYCLOAK_PUBLISHED_PORT=8090

# PostgreSQL
POSTGRES_USER=larex_prod
POSTGRES_PASSWORD=change-me
POSTGRES_DB=larexdb

# Bundled Keycloak bootstrap admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_HOSTNAME=localhost:8090
KEYCLOAK_FRONTEND_URL=
KEYCLOAK_HOSTNAME_STRICT=false
KEYCLOAK_HOSTNAME_STRICT_HTTPS=false
KEYCLOAK_HTTP_ENABLED=true
KEYCLOAK_PROXY_HEADERS=xforwarded
LAREX_INITIAL_ADMIN_USERNAME=admin
LAREX_INITIAL_ADMIN_EMAIL=admin@example.org
LAREX_INITIAL_ADMIN_FIRST_NAME=LAREX
LAREX_INITIAL_ADMIN_LAST_NAME=Administrator
LAREX_INITIAL_ADMIN_TEMP_PASSWORD=change-me-initial-admin

# Backend -> Keycloak
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_RESOURCE_CLIENT_ID=larex-backend
KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080
KEYCLOAK_ADMIN_REALM=larex-prod
KEYCLOAK_ACTION_EMAIL_CLIENT_ID=larex-frontend
KEYCLOAK_ACTION_EMAIL_REDIRECT_URI=http://localhost:3000/auth/keycloak
KEYCLOAK_ACTION_EMAIL_LIFESPAN_SECONDS=43200
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8090/realms/larex-prod
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:8080/realms/larex-prod/protocol/openid-connect/certs

# App / CORS
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Frontend session + OAuth runtime config
NUXT_SESSION_PASSWORD=replace-with-random-32-plus-character-secret
NUXT_API_BASE_INTERNAL=http://app:8080/api/v1
NUXT_OAUTH_KEYCLOAK_SERVER_URL=http://localhost:8090
NUXT_OAUTH_KEYCLOAK_SERVER_URL_INTERNAL=http://keycloak:8080
NUXT_OAUTH_KEYCLOAK_REALM=larex-prod
NUXT_OAUTH_KEYCLOAK_CLIENT_ID=larex-frontend
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=change-me
NUXT_OAUTH_KEYCLOAK_REDIRECT_URL=http://localhost:3000/auth/keycloak

# Optional mail configuration
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_STARTTLS=true
