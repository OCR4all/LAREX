# LAREX opinionated production setup
# Default command:
#   cp deployment/env/.env.prod.example .env.prod
#   docker compose --env-file .env.prod \
#     -f compose.prod.base.yaml \
#     -f compose.prod.auth.bundled-keycloak.yaml \
#     -f compose.prod.publish.localhost.yaml \
#     up -d
#
# This setup publishes frontend on 3000 and bundled Keycloak on 8090, both bound to
# 127.0.0.1 by default so you can place your own reverse proxy in front.

# Public hosts used to derive OAuth, issuer, and redirect URLs.
LAREX_INSTANCE_NAME="LAREX Production"
LAREX_PUBLIC_HOST=app.example.org
KEYCLOAK_PUBLIC_HOST=auth.example.org
KEYCLOAK_REALM=larex-prod
NUXT_PUBLIC_DOCUMENTATION_URL=https://docs.larex.kallimachos.de

# Bind published ports on the Docker host.
LAREX_BIND_IP=127.0.0.1
LAREX_FRONTEND_PORT=3000
KEYCLOAK_PUBLISHED_PORT=8090
LAREX_DOCS_PORT=3001

# Backend/frontend image tag. Use a release version for production, or a branch
# tag such as dev, staging, or next for non-production environments. Override
# LAREX_BACKEND_IMAGE or LAREX_FRONTEND_IMAGE only when using a fork or private registry.
LAREX_IMAGE_TAG=latest
# LAREX_BACKEND_IMAGE=ghcr.io/ocr4all/larex/backend:latest
# LAREX_FRONTEND_IMAGE=ghcr.io/ocr4all/larex/frontend:latest

# PostgreSQL
POSTGRES_USER=larex_prod
POSTGRES_PASSWORD=change-me

# Bundled Keycloak PostgreSQL
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=change-me

# Bundled Keycloak bootstrap admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
LAREX_INITIAL_ADMIN_USERNAME=admin
LAREX_INITIAL_ADMIN_EMAIL=admin@example.org
LAREX_INITIAL_ADMIN_FIRST_NAME=LAREX
LAREX_INITIAL_ADMIN_LAST_NAME=Administrator
LAREX_INITIAL_ADMIN_TEMP_PASSWORD=change-me-initial-admin
LAREX_USER_PROVISIONING_MODE=LOCAL

# Frontend session + OAuth client secret
NUXT_SESSION_PASSWORD=replace-with-random-32-plus-character-secret
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=change-me
NUXT_NOTIFICATION_BRIDGE_SECRET=change-me
NUXT_COLLABORATION_SECRET=change-me
LAREX_NOTIFICATIONS_BRIDGE_SECRET=change-me
LAREX_ACTION_ENDPOINT_SECRET_ENCRYPTION_KEY=change-me
LAREX_ACTION_RESULT_MAX_FILE_BYTES=104857600
LAREX_ACTION_RESULT_MAX_TOTAL_BYTES=503316480

# Project package ZIP extraction limits
# LAREX_PROJECT_PACKAGE_MAX_ARCHIVE_BYTES=134217728
# LAREX_PROJECT_PACKAGE_MAX_ENTRIES=100000
# LAREX_PROJECT_PACKAGE_MAX_ENTRY_BYTES=536870912
# LAREX_PROJECT_PACKAGE_MAX_TOTAL_BYTES=2147483648
# LAREX_PROJECT_PACKAGE_MAX_DESCRIPTOR_BYTES=16777216
# LAREX_PROJECT_PACKAGE_MAX_COMPRESSION_RATIO=200
# LAREX_PROJECT_PACKAGE_PREVIEW_MAX_CACHED_BYTES=4294967296
# LAREX_PROJECT_PACKAGE_PREVIEW_MAX_SESSIONS=64
# LAREX_PROJECT_PACKAGE_PREVIEW_EXPIRE_MINUTES=30

# Optional mail configuration
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_STARTTLS=true

# Optional Action processor fallback secret examples:
# LAREX_ACTION_ENDPOINT_SECRET_OCR_PROCESSOR_V1=change-me
# Official processor services use compose.actions.yaml and a separate .env.actions.

# Optional advanced overrides
# KEYCLOAK_ACTION_EMAIL_LIFESPAN_SECONDS=43200
# LAREX_UPLOAD_DIR=/mnt/data/uploads
# LAREX_UPLOAD_TEMP_DIR=/mnt/data/uploads/temp
# LAREX_ASYNC_REQUEST_TIMEOUT=30m
# LAREX_IIIF_DOWNLOAD_MIN_INTERVAL_MS=100
# LAREX_IIIF_MAX_IMAGE_DOWNLOAD_BYTES=536870912
# LAREX_IIIF_PREVIEW_ASYNC_CORE_POOL=2
# LAREX_IIIF_PREVIEW_ASYNC_MAX_POOL=4
# LAREX_IIIF_PREVIEW_ASYNC_QUEUE=100
# LAREX_IIIF_DOWNLOAD_ASYNC_CORE_POOL=1
# LAREX_IIIF_DOWNLOAD_ASYNC_MAX_POOL=2
# LAREX_IIIF_DOWNLOAD_ASYNC_QUEUE=50
# LAREX_IIIF_WORKER_LEASE_DURATION_MS=120000
# LAREX_IIIF_WORKER_HEARTBEAT_INTERVAL_MS=30000
# LAREX_IIIF_WORKER_RECOVERY_INTERVAL_MS=5000
# KEYCLOAK_ADMIN_SERVER_URL=https://auth.example.org
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://auth.example.org/realms/larex-prod
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=https://auth.example.org/realms/larex-prod/protocol/openid-connect/certs
# NUXT_OAUTH_KEYCLOAK_SERVER_URL=https://auth.example.org
# NUXT_OAUTH_KEYCLOAK_SERVER_URL_INTERNAL=https://auth.example.org
# NUXT_OAUTH_KEYCLOAK_REDIRECT_URL=https://app.example.org/auth/keycloak

# External Keycloak override:
# Use compose.prod.auth.external-keycloak.yaml instead of compose.prod.auth.bundled-keycloak.yaml
# and use the explicit Keycloak URL overrides above only if the server-side URL differs
# from KEYCLOAK_PUBLIC_HOST.

# Optional bundled Nginx override:
# Add -f compose.prod.nginx.yaml and place certificates in NGINX_CERTS_DIR.
# NGINX_CERTS_DIR=./deployment/nginx/certs
# KEYCLOAK_UPSTREAM=http://keycloak:8080
# For external Keycloak + Nginx, point KEYCLOAK_UPSTREAM at the external auth URL instead.
