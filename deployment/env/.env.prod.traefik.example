# LAREX advanced/secondary Traefik production preset (compose.prod.traefik.yaml)
# Traefik + LetsEncrypt + bundled Keycloak
# Usage:
#   cp deployment/env/.env.prod.traefik.example .env.prod.traefik
#   docker compose --env-file .env.prod.traefik -f compose.prod.traefik.yaml up -d

# PostgreSQL
POSTGRES_USER=larex_prod
POSTGRES_PASSWORD=change-me
POSTGRES_DB=larexdb

# Bundled Keycloak bootstrap admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_HOSTNAME=auth.example.org
LAREX_INITIAL_ADMIN_USERNAME=admin
LAREX_INITIAL_ADMIN_EMAIL=admin@example.org
LAREX_INITIAL_ADMIN_FIRST_NAME=LAREX
LAREX_INITIAL_ADMIN_LAST_NAME=Administrator
LAREX_INITIAL_ADMIN_TEMP_PASSWORD=change-me-initial-admin

# Backend -> Keycloak
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_RESOURCE_CLIENT_ID=larex-backend
KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080
KEYCLOAK_ADMIN_REALM=larex-prod
KEYCLOAK_ACTION_EMAIL_CLIENT_ID=larex-frontend
KEYCLOAK_ACTION_EMAIL_REDIRECT_URI=https://app.example.org/auth/keycloak
KEYCLOAK_ACTION_EMAIL_LIFESPAN_SECONDS=43200
LAREX_USER_PROVISIONING_MODE=LOCAL
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://auth.example.org/realms/larex-prod
# Optional JWK override (internal container URL is typical with Traefik)
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://keycloak:8080/realms/larex-prod/protocol/openid-connect/certs

# Public routing / CORS / TLS
FRONTEND_HOSTNAME=app.example.org
API_HOSTNAME=api.example.org
CORS_ALLOWED_ORIGIN=https://app.example.org
ACME_EMAIL=admin@example.org

# Frontend session + OAuth runtime config
NUXT_SESSION_PASSWORD=replace-with-random-32-plus-character-secret
NUXT_API_BASE_INTERNAL=http://app:8080/api/v1
NUXT_OAUTH_KEYCLOAK_SERVER_URL=https://auth.example.org
NUXT_OAUTH_KEYCLOAK_SERVER_URL_INTERNAL=http://keycloak:8080
NUXT_OAUTH_KEYCLOAK_REALM=larex-prod
NUXT_OAUTH_KEYCLOAK_CLIENT_ID=larex-frontend
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=change-me
NUXT_OAUTH_KEYCLOAK_REDIRECT_URL=https://app.example.org/auth/keycloak

# Optional mail configuration
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
