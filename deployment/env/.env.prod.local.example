# LAREX production-like local preset (compose.prod.local.yaml)
# Traefik + *.localhost + Mailpit, production images/runtime config
# Usage:
#   cp deployment/env/.env.prod.local.example .env.prod.local
#   docker compose --env-file .env.prod.local -f compose.prod.local.yaml up -d

# Bind Traefik dashboard and Mailpit ports to localhost by default
LAREX_LOCAL_BIND_IP=127.0.0.1

# Only the OAuth client secrets and session password are typically required because compose.prod.local.yaml
# provides local defaults for most other values.
NUXT_SESSION_PASSWORD=replace-with-random-32-plus-character-secret
KEYCLOAK_ADMIN_CLIENT_SECRET=PLEASE_CHANGE_IN_PRODUCTION
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=PLEASE_CHANGE_IN_PRODUCTION

# Optional overrides (defaults shown)
# POSTGRES_USER=larex
# POSTGRES_PASSWORD=larex_dev_pw
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_HOSTNAME=http://keycloak.localhost
# KEYCLOAK_RESOURCE_CLIENT_ID=larex-backend
# KEYCLOAK_ACTION_EMAIL_CLIENT_ID=larex-frontend
# KEYCLOAK_ACTION_EMAIL_REDIRECT_URI=http://larex.localhost/auth/keycloak
# KEYCLOAK_ACTION_EMAIL_LIFESPAN_SECONDS=43200
# KEYCLOAK_ADMIN_SERVER_URL=http://keycloak:8080
# KEYCLOAK_ADMIN_REALM=larex-dev
# CORS_ALLOWED_ORIGIN=http://larex.localhost
# NUXT_OAUTH_KEYCLOAK_SERVER_URL=http://keycloak.localhost
# NUXT_OAUTH_KEYCLOAK_SERVER_URL_INTERNAL=http://keycloak.localhost
# NUXT_OAUTH_KEYCLOAK_REALM=larex-dev
# NUXT_OAUTH_KEYCLOAK_CLIENT_ID=larex-frontend
# NUXT_OAUTH_KEYCLOAK_REDIRECT_URL=http://larex.localhost/auth/keycloak
