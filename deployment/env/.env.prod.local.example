# LAREX production-like local setup
# Default command:
#   cp deployment/env/.env.prod.local.example .env.prod.local
#   docker compose --env-file .env.prod.local \
#     -f compose.prod.base.yaml \
#     -f compose.prod.auth.bundled-keycloak.yaml \
#     -f compose.prod.local.yaml \
#     up -d

# Local Traefik and Mailpit bind to localhost by default.
LAREX_BIND_IP=127.0.0.1

# Local production-like hosts and realm.
LAREX_INSTANCE_NAME="LAREX Local"
NUXT_PUBLIC_DOCUMENTATION_URL=https://docs.larex.kallimachos.de
KEYCLOAK_REALM=larex-local

# Backend/frontend image tag. Use a release version for production, or a branch
# tag such as dev, staging, or next for non-production environments. Override
# LAREX_BACKEND_IMAGE or LAREX_FRONTEND_IMAGE only when using a fork or private registry.
LAREX_IMAGE_TAG=latest
# LAREX_BACKEND_IMAGE=ghcr.io/ocr4all/larex/backend:latest
# LAREX_FRONTEND_IMAGE=ghcr.io/ocr4all/larex/frontend:latest

# Local defaults match the historical local stack so existing local volumes continue to work.
POSTGRES_USER=larex
POSTGRES_PASSWORD=larex_dev_pw
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=keycloak_dev_pw
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Required secrets
NUXT_SESSION_PASSWORD=replace-with-random-32-plus-character-secret
KEYCLOAK_ADMIN_CLIENT_SECRET=PLEASE_CHANGE_IN_PRODUCTION
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=PLEASE_CHANGE_IN_PRODUCTION
NUXT_NOTIFICATION_BRIDGE_SECRET=PLEASE_CHANGE_IN_PRODUCTION
NUXT_COLLABORATION_SECRET=PLEASE_CHANGE_IN_PRODUCTION
LAREX_NOTIFICATIONS_BRIDGE_SECRET=PLEASE_CHANGE_IN_PRODUCTION
LAREX_ACTION_ENDPOINT_SECRET_ENCRYPTION_KEY=PLEASE_CHANGE_IN_PRODUCTION
LAREX_ACTION_ENDPOINT_SECRET_KRAKEN_SEGMENTATION_V1=PLEASE_CHANGE_IN_PRODUCTION

# Optional overrides
# LAREX_INITIAL_ADMIN_USERNAME=admin
# LAREX_INITIAL_ADMIN_EMAIL=admin@example.org
# LAREX_INITIAL_ADMIN_FIRST_NAME=LAREX
# LAREX_INITIAL_ADMIN_LAST_NAME=Administrator
# LAREX_INITIAL_ADMIN_TEMP_PASSWORD=change-me-initial-admin
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_FROM=noreply@larex.localhost
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_SSL_ENABLE=false
# MAIL_SMTP_STARTTLS=false
# LAREX_ASYNC_REQUEST_TIMEOUT=30m
# KEYCLOAK_SMTP_FROM_DISPLAY_NAME=LAREX Dev
# Add -f compose.prod.kraken.yaml to host the bundled Kraken segmentation processor.
# LAREX_ACTIONS_PUBLIC_BASE_URL=http://app:8080/api/v1
# LAREX_ACTIONS_ENDPOINT_ALLOWED_ORIGINS=http://kraken-segmentation-processor:9000
# LAREX_ALLOWED_CALLBACK_ORIGINS=http://app:8080
# KRAKEN_DEVICE=cpu
# KRAKEN_PRECISION=32-true
# KRAKEN_TEXT_DIRECTION=horizontal-lr
# KRAKEN_SEGMENTATION_MODEL=
# KRAKEN_MAX_PROCESS_SECONDS=900
