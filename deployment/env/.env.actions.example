# Optional official LAREX Action processor services.
#
# Create .env.actions with:
#   scripts/bootstrap-env-secrets.sh actions
#
# Start every official processor in local development with:
#   docker compose --env-file .env.actions \
#     -f compose.yaml \
#     -f compose.actions.yaml \
#     --profile actions up -d

# Shared callback and endpoint policy. The defaults use the private Compose network.
LAREX_ACTIONS_PUBLIC_BASE_URL=http://app:8080/api/v1
LAREX_ACTIONS_CALLBACK_ALLOWED_ORIGINS=http://app:8080
# The mock origin keeps the development processor available. Remove it from a
# production allowlist when the mock processor is not deployed.
LAREX_ACTIONS_ENDPOINT_ALLOWED_ORIGINS=http://action-kraken-segmentation:9000,http://mock-action-processor:9000

# Kraken segmentation processor.
LAREX_ACTION_KRAKEN_IMAGE_TAG=0.4.0
# LAREX_ACTION_KRAKEN_IMAGE=ghcr.io/ocr4all/larex-action-kraken:0.4.0
LAREX_ACTION_ENDPOINT_SECRET_KRAKEN_SEGMENTATION_V1=PLEASE_CHANGE_IN_PRODUCTION
KRAKEN_DEVICE=cpu
KRAKEN_PRECISION=32-true
KRAKEN_TEXT_DIRECTION=horizontal-lr
KRAKEN_SEGMENTATION_MODEL=
KRAKEN_MAX_PROCESS_SECONDS=900
KRAKEN_MAX_CONCURRENT_RUNS=1

# Container resource and temporary-workspace limits.
LAREX_ACTION_KRAKEN_CPU_LIMIT=4
LAREX_ACTION_KRAKEN_MEMORY_LIMIT=8G
LAREX_ACTION_KRAKEN_TMPFS_SIZE=4g
