map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${LAREX_PUBLIC_HOST} ${KEYCLOAK_PUBLIC_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${LAREX_PUBLIC_HOST};

    ssl_certificate /etc/nginx/certs/${LAREX_PUBLIC_HOST}.crt;
    ssl_certificate_key /etc/nginx/certs/${LAREX_PUBLIC_HOST}.key;

    client_max_body_size 500m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    location /_ws {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://frontend:3000/_ws;
    }

    location /api/upload-proxy/ {
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_pass http://frontend:3000;
    }

    location / {
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_pass http://frontend:3000;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${KEYCLOAK_PUBLIC_HOST};

    ssl_certificate /etc/nginx/certs/${KEYCLOAK_PUBLIC_HOST}.crt;
    ssl_certificate_key /etc/nginx/certs/${KEYCLOAK_PUBLIC_HOST}.key;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    location / {
        resolver 127.0.0.11 ipv6=off;
        set $keycloak_upstream ${KEYCLOAK_UPSTREAM};
        proxy_pass $keycloak_upstream;
    }
}
