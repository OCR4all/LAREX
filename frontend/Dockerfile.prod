FROM ghcr.io/pnpm/pnpm:12.23.0@sha256:349c846c6c9dab76b2f6fbf4b2df14d5a8c9b2a0fce92fc7e5c2eec3f437e801 AS base

RUN pnpm runtime set node 22.23.5 -g

WORKDIR /app

FROM base AS builder

ARG NODE_MAX_OLD_SPACE_SIZE=6144

# Copy package manifests first for layer caching and deterministic installs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Build must use the checked-in lockfile, otherwise Nuxt standalone output can
# reference package layouts that differ from the runtime image.
RUN pnpm install --frozen-lockfile

COPY . .

ARG VERSION
RUN NUXT_PUBLIC_APP_VERSION="$VERSION" NODE_OPTIONS="--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}" pnpm build

FROM node:22.23.5-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS runner

RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules /opt/yarn-* \
        /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
        /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -g 1001 -S nodejs \
    && adduser -S -u 1001 -G nodejs -h /app nuxt

WORKDIR /app

COPY --from=builder --chown=nuxt:nodejs /app/.output ./.output

USER nuxt

EXPOSE 3000

ENV NODE_ENV=production
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

CMD ["node", ".output/server/index.mjs"]
