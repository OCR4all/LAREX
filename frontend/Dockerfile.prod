# Frontend Production Dockerfile
FROM node:22-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@latest

# Copy package manifests first for layer caching and deterministic installs
COPY package.json pnpm-lock.yaml ./

# Build must use the checked-in lockfile, otherwise Nuxt standalone output can
# reference package layouts that differ from the runtime image.
RUN pnpm install --frozen-lockfile

COPY . .

RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm build
RUN pnpm build

FROM node:22-alpine AS runner

WORKDIR /app

COPY --from=builder /app/.output ./.output

RUN addgroup -g 1001 -S nodejs
RUN adduser -S nuxt -u 1001

RUN chown -R nuxt:nodejs /app
USER nuxt

EXPOSE 3000

ENV NODE_ENV=production
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

CMD ["node", ".output/server/index.mjs"]
