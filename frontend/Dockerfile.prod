FROM ghcr.io/pnpm/pnpm:11.1.1 AS base

RUN pnpm runtime set node 22 -g

WORKDIR /app

FROM base AS builder

ARG NODE_MAX_OLD_SPACE_SIZE=6144

# Copy package manifests first for layer caching and deterministic installs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Build must use the checked-in lockfile, otherwise Nuxt standalone output can
# reference package layouts that differ from the runtime image.
RUN pnpm install --frozen-lockfile

COPY . .

RUN NODE_OPTIONS="--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}" pnpm build

FROM base AS runner

COPY --from=builder /app/.output ./.output

RUN groupadd --gid 1001 nodejs
RUN useradd --uid 1001 --gid nodejs --home /app nuxt

RUN chown -R nuxt:nodejs /app
USER nuxt

EXPOSE 3000

ENV NODE_ENV=production
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

CMD ["node", ".output/server/index.mjs"]
