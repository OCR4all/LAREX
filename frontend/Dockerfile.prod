FROM ghcr.io/pnpm/pnpm:11.1.1@sha256:18bcf6373f2ca9b74f13d939951f02b4514ec10a6f548fec8cfe28eb02cc4b4f AS base

RUN pnpm runtime set node 22.23.4 -g

WORKDIR /app

FROM base AS builder

ARG NODE_MAX_OLD_SPACE_SIZE=6144

# Copy package manifests first for layer caching and deterministic installs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Build must use the checked-in lockfile, otherwise Nuxt standalone output can
# reference package layouts that differ from the runtime image.
RUN pnpm install --frozen-lockfile

COPY . .

ARG VERSION
RUN NUXT_PUBLIC_APP_VERSION="$VERSION" NODE_OPTIONS="--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE}" pnpm build

FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS runner

RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules /opt/yarn-* \
        /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
        /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -g 1001 -S nodejs \
    && adduser -S -u 1001 -G nodejs -h /app nuxt

WORKDIR /app

COPY --from=builder --chown=nuxt:nodejs /app/.output ./.output

USER nuxt

EXPOSE 3000

ENV NODE_ENV=production
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

CMD ["node", ".output/server/index.mjs"]
