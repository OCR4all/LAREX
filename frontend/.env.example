# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Stable, human-readable name for this deployment
NUXT_PUBLIC_INSTANCE_NAME="LAREX Local"

# Public documentation URL (override when self-hosting the documentation)
NUXT_PUBLIC_DOCUMENTATION_URL=https://docs.larex.kallimachos.de

# Internal API URL for server-to-server communication (within Docker network)
NUXT_API_BASE_INTERNAL=http://app:8080/api/v1

# Session encryption password (minimum 32 characters)
NUXT_SESSION_PASSWORD=your-32-character-minimum-secret-here

# Keycloak OAuth configuration (see nuxt.config.ts for structure)
# NUXT_OAUTH_KEYCLOAK_SERVER_URL=http://keycloak.localhost
# NUXT_OAUTH_KEYCLOAK_REALM=larex-dev
# NUXT_OAUTH_KEYCLOAK_CLIENT_ID=larex-frontend
# NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=your-client-secret
# NUXT_OAUTH_KEYCLOAK_REDIRECT_URL=http://larex.localhost/auth/keycloak
